// Browser side: the main entry (src/index.ts) and everything it reaches, with no Node types,
// so `process`, `Buffer` or a node: import in these files fails the typecheck (#72).
// composite makes importing a ./node file from here an error too (TS6307): that file is not
// in this project, and its `/// <reference types="node" />` would bring Node's types back.
// The excluded paths are the ./node entry; tsconfig.node.build.json includes the same three.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [],
    "composite": true,
    "rootDir": "src",
    // composite keeps build info; outside dist/ and git-ignored (*.tsbuildinfo).
    "tsBuildInfoFile": "node_modules/.cache/tsc/browser-check.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/sources/node.ts", "src/sources/claude-code", "src/history"]
}
