{
  "name": "@orbitrace/core",
  "version": "0.0.0",
  "description": "Orbitrace core: transcript parsing, source resolution, replay model and export. No editor dependency.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farisology/orbitrace.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/farisology/orbitrace/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/farisology/orbitrace/issues"
  },
  "keywords": [
    "agent",
    "replay",
    "transcript",
    "orrery",
    "visualizer"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/sources/node.d.ts",
      "default": "./dist/sources/node.js"
    },
    "./schema/replay-v1.schema.json": "./schema/replay-v1.schema.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "schema"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "prettier": "^3.10.1"
  }
}
