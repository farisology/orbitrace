{
  "name": "@orbitrace/core",
  "version": "0.0.0",
  "description": "Orbitrace core: transcript parsing, source resolution, replay model and export. No editor dependency.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
