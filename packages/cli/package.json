{
  "name": "orbitrace",
  "version": "0.0.0",
  "private": true,
  "description": "Orbitrace command line: list Claude Code sessions and export structure-only replays. Not affiliated with Anthropic.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "orbitrace": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-app.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@orbitrace/core": "0.0.0"
  },
  "devDependencies": {
    "@orbitrace/app": "0.0.0",
    "@orbitrace/fixtures": "0.0.0",
    "@orbitrace/renderer": "0.0.0",
    "@types/node": "^20.19.43"
  }
}
