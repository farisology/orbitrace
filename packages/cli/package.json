{
  "name": "orbitrace",
  "version": "0.0.0",
  "private": true,
  "description": "Orbitrace command line: list Claude Code sessions, open one in the browser and export structure-only replays. Orbitrace is an independent project. It is not affiliated with or endorsed by Anthropic.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farisology/orbitrace.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/farisology/orbitrace/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/farisology/orbitrace/issues"
  },
  "keywords": [
    "agent",
    "replay",
    "orrery",
    "visualizer",
    "cli"
  ],
  "type": "module",
  "bin": {
    "orbitrace": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/index.js",
    "dist/app"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@orbitrace/app": "0.0.0",
    "@orbitrace/core": "0.0.0",
    "@orbitrace/fixtures": "0.0.0",
    "@orbitrace/renderer": "0.0.0",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2"
  }
}
