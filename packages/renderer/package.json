{
  "name": "@orbitrace/renderer",
  "version": "0.0.0",
  "description": "Orbitrace renderer: a framework-free Canvas 2D engine that draws a replay model.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farisology/orbitrace.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/farisology/orbitrace/tree/main/packages/renderer#readme",
  "bugs": {
    "url": "https://github.com/farisology/orbitrace/issues"
  },
  "keywords": [
    "agent",
    "replay",
    "orrery",
    "canvas",
    "visualizer"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "vite --config demo/vite.config.ts",
    "generate": "node scripts/generate-design.mjs",
    "generate:check": "node scripts/generate-design.mjs --check",
    "bench:browser": "node scripts/bench-browser.mjs",
    "bench:node": "vitest run --config perf/vitest.config.ts"
  },
  "dependencies": {
    "@orbitrace/core": "0.0.0"
  },
  "devDependencies": {
    "@orbitrace/fixtures": "0.0.0",
    "@types/node": "^20.19.43",
    "vite": "^8.3.8"
  }
}
