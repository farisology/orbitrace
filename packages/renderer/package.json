{
  "name": "@orbitrace/renderer",
  "version": "0.0.0",
  "description": "Orbitrace renderer: a framework-free Canvas 2D engine that draws a replay model.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "vite --config demo/vite.config.ts",
    "generate": "node scripts/generate-design.mjs",
    "generate:check": "node scripts/generate-design.mjs --check",
    "bench:browser": "node scripts/bench-browser.mjs"
  },
  "dependencies": {
    "@orbitrace/core": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "vite": "^8.3.8"
  }
}
